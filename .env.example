# =============================================
# SkillBook Environment Variables
# Copy to .env and fill in real values.
# NEVER commit real secrets to Git.
# =============================================

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5433/skillbook
DB_USERNAME=postgres
DB_PASSWORD=password

# --- JWT (used from Phase 3) ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# --- Stripe (used from Phase 8) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_RETURN_URL=http://localhost:5191/bookings

# --- Mail (used from Phase 9) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENABLED=false
MAIL_HEALTH_ENABLED=false

# --- Session scheduler (used from Phase 9) ---
SCHEDULER_ENABLED=true

# --- Browser session ---
SESSION_COOKIE_SECURE=false

# --- Integrations ---
# Optional Google Identity Services web client (public OAuth client ID)
GOOGLE_CLIENT_ID=
# Brevo transactional email; also set MAIL_ENABLED=true
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# --- Frontend ---
# Pass this to Vite explicitly or place it in frontend/.env.local.
VITE_API_BASE_URL=http://localhost:8081/api
